# Example environment configuration.
#
# Development: copy to .env.local to override the defaults in .env.
# Production:  set these in the hosting provider (e.g. Vercel project settings).
#
# VITE_* values are compiled into the client bundle and are publicly visible.
# Never put credentials, API keys, tokens or other secrets in them.

# Backend API base URL. It must include the backend context path (/api).
# Required for production builds.
VITE_API_BASE_URL=https://your-backend.example.com/api

# Feature flags
# Security backend is now available
VITE_ENABLE_SECURITY=true

# Audit backend is now available
VITE_ENABLE_AUDIT=true
