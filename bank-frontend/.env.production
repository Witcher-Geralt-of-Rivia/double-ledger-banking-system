# Production configuration (loaded by `vite build`).
#
# VITE_API_BASE_URL is intentionally empty. Production builds must receive it
# from the hosting provider's environment variables (e.g. Vercel project
# settings); the build fails if it is missing. Do not commit a backend URL here.
VITE_API_BASE_URL=
VITE_ENABLE_SECURITY=true
VITE_ENABLE_AUDIT=true
